{
  "name": "professional-profile-site",
  "private": true,
  "description": "Static resume site: test and lint tooling only, nothing here is deployed.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/unit/",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "serve": "node tests/server.mjs",
    "lint": "htmlhint ./*.html && stylelint \"*.css\" && eslint . && prettier --check \"*.{html,css,js,json,mjs}\" \"tests/**/*.mjs\""
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "eslint": "10.12.0",
    "happy-dom": "20.14.5",
    "htmlhint": "1.9.2",
    "prettier": "3.9.9",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0"
  }
}
